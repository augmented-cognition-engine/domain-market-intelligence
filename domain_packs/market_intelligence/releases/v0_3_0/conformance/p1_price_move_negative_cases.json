{
  "contract": "ace.market-intelligence.negative-conformance-cases/v1alpha1",
  "fixture_id": "p1_price_move_negative_cases",
  "fixture_version": "0.2.0",
  "fixture_scope": "prepared_conformance_input",
  "base_fixture_path": "p1_price_move_golden.json",
  "base_fixture_digest": "sha256:5d04afed27b785f35cbd29083d566bb84770a2fbdf4a44837ea196e432dd1cdf",
  "operation_contract": "rfc6902-replace-only",
  "cases": [
    {
      "case_id": "source_definition_mismatch",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/source_definition_ref",
          "value": "source_definition:other-public-product"
        }
      ],
      "expected_rejection_stage": "source_admission",
      "expected_error_pattern": "definition does not match"
    },
    {
      "case_id": "non_https_public_source",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/source_uri",
          "value": "http://example.com/public/northstar/edge-x1"
        }
      ],
      "expected_rejection_stage": "source_admission",
      "expected_error_pattern": "URI scheme"
    },
    {
      "case_id": "captured_payload_digest_mismatch",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/captured_payload_digest",
          "value": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        }
      ],
      "expected_rejection_stage": "source_admission",
      "expected_error_pattern": "captured_payload_digest"
    },
    {
      "case_id": "missing_acquisition_receipt_reference",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/acquisition_receipt_ref",
          "value": ""
        }
      ],
      "expected_rejection_stage": "source_admission",
      "expected_error_pattern": "bounded stable reference"
    },
    {
      "case_id": "cross_product_comparison",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/resolved_subject/entity_ref",
          "value": "product:northstar_edge_x2"
        }
      ],
      "expected_rejection_stage": "comparison",
      "expected_error_pattern": "same entity"
    },
    {
      "case_id": "cross_currency_comparison",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/captured_payload/currency",
          "value": "EUR"
        },
        {
          "op": "replace",
          "path": "/snapshots/1/source/captured_payload_digest",
          "value": "sha256:069c8ec66dd90ad4fee9130dd10e040822c1c5b51a8e9643f1f20199cee75560"
        }
      ],
      "expected_rejection_stage": "comparison",
      "expected_error_pattern": "context attribute currency changed"
    },
    {
      "case_id": "current_snapshot_not_available_at_detection",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/ingested_at",
          "value": "2026-02-15T12:05:00Z"
        }
      ],
      "expected_rejection_stage": "comparison",
      "expected_error_pattern": "before both snapshots were projected"
    },
    {
      "case_id": "prepared_interpreter_rejects_live_acquisition",
      "operations": [
        {
          "op": "replace",
          "path": "/snapshots/1/source/acquisition_mode",
          "value": "live"
        }
      ],
      "expected_rejection_stage": "source_admission",
      "expected_error_pattern": "rejects every LIVE source snapshot"
    }
  ],
  "limitations": [
    "These are Market-owned prepared input vectors, not a generic conformance runner or live admission service.",
    "ACE Platform remains responsible for durable activation, authority and receipt resolution, replay, and restart acceptance."
  ]
}
